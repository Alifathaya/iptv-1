# OpenAI API key from https://platform.openai.com/api-keys
# NEVER commit the real key. Copy this file to .env on the VPS and edit it there.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_SECONDS=180

# Separate secret used by the app to authenticate to this backend.
# Generate a long random value. This is NOT the OpenAI API key.
API_KEY=replace-with-a-long-random-backend-key

# Restrict browser origins to the app origins you actually use.
ALLOWED_ORIGINS=https://alifathaya.github.io,capacitor://localhost,https://localhost,http://localhost:8765
MAX_UPLOAD_MB=25
