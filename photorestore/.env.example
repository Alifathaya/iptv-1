# Contoh konfigurasi — JANGAN isi secret asli di sini, copy ke .env
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=fotorestore
STORAGE_ROOT=/tmp/prestore-p1/photorestore/storage
MAX_UPLOAD_MB=10
MIN_DIMENSION=32
MAX_DIMENSION=4096
KEEP_EXIF=false
TEMP_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=30
JOB_TIMEOUT=600
# Phase 2: upscale + denoise
UPSCALE_SMALL_PX=1000
UPSCALE_LARGE_PX=2000
USE_REALESRGAN=false
MODEL_DIR=/opt/restore/weights
FACE_CASCADE_PATH=/usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml
# Phase 3: wajah
YUNET_MODEL=/tmp/prestore-p1/photorestore/models/weights/face_detection_yunet_2023mar.onnx
FACE_MIN_SCORE=0.6
FACE_CONFIDENT_SCORE=0.75
GFPGAN_WEIGHTS=/opt/restore/weights/GFPGANv1.4.pth
# Phase 5: GPU worker terpisah (kosongkan = semua lokal CPU)
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
GPU_TIMEOUT=300
GPU_RETRIES=1
# Phase 6: generatif opsional (hanya di server, tak pernah di APK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1
# Phase 5+: OPENAI_API_KEY= (opsional, hanya di server)
