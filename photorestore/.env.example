# Contoh konfigurasi — JANGAN isi secret asli di sini, copy ke .env
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=fotorestore
STORAGE_ROOT=/tmp/prestore-p1/photorestore/storage
MAX_UPLOAD_MB=10
MIN_DIMENSION=32
MAX_DIMENSION=4096
KEEP_EXIF=false
TEMP_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=30
JOB_TIMEOUT=600
# Phase 2: upscale + denoise
UPSCALE_SMALL_PX=1000
UPSCALE_LARGE_PX=2000
USE_REALESRGAN=false
MODEL_DIR=/opt/restore/weights
FACE_CASCADE_PATH=/usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml
# Phase 5+: OPENAI_API_KEY= (opsional, hanya di server)
